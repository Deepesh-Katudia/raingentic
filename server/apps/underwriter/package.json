{
  "name": "@float/underwriter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--experimental-sqlite --no-warnings\" tsx watch src/index.ts",
