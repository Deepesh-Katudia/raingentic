{
  "name": "float",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -n seller,buyers,underwriter,dash -c green,yellow,cyan,magenta \"pnpm -F @float/seller-agent dev\" \"pnpm -F @float/buyer-agents dev\" \"pnpm -F @float/underwriter dev\" \"pnpm -F @float/dashboard dev\"",
    "dev:core": "concurrently -n seller,underwriter -c green,cyan \"pnpm -F @float/seller-agent dev\" \"pnpm -F @float/underwriter dev\"",
    "contracts:build": "pnpm -F @float/contracts build",
    "contracts:test": "pnpm -F @float/contracts test",
    "contracts:deploy": "pnpm -F @float/contracts deploy",
    "smoke:x402": "pnpm -F @float/buyer-agents smoke",
    "typecheck": "tsc -b --pretty false"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
